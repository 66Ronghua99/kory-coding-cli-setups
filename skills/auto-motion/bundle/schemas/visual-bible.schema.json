{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-motion.local/schemas/visual-bible.schema.json",
  "title": "Auto-motion visual bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "full_story_summary", "canvas", "palette", "typography", "layout", "motion", "asset_treatment", "forbidden_patterns"],
  "properties": {
    "schema_version": { "const": 1 },
    "full_story_summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background", "safe_area"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "minLength": 1 },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "text", "surface"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading_font", "body_font", "fallback_fonts"],
      "properties": {
        "heading_font": { "type": "string", "minLength": 1 },
        "body_font": { "type": "string", "minLength": 1 },
        "fallback_fonts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "margins", "density", "hierarchy"],
      "properties": {
        "grid": { "type": "string", "minLength": 1 },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        },
        "density": { "type": "string", "minLength": 1 },
        "hierarchy": { "type": "string", "minLength": 1 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["easing", "density", "entry", "exit", "transition_family"],
      "properties": {
        "easing": { "type": "string", "minLength": 1 },
        "density": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "exit": { "type": "string", "minLength": 1 },
        "transition_family": { "type": "string", "minLength": 1 }
      }
    },
    "asset_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "icons", "logos", "code"],
      "properties": {
        "images": { "type": "string", "minLength": 1 },
        "icons": { "type": "string", "minLength": 1 },
        "logos": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
