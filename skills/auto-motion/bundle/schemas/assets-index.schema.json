{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-motion.local/schemas/assets-index.schema.json",
  "title": "Auto-motion assets index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "source_url", "license_note", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[^\\\\]+$" },
          "media_type": { "type": "string", "enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp", "image/gif", "video/mp4"] },
          "source_url": { "type": "string", "minLength": 1 },
          "license_note": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
