{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-motion.local/schemas/scene-plan.schema.json",
  "title": "Auto-motion scene plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "start_ms", "end_ms", "subtitle_ids", "goal", "visual", "beats", "assets", "recipe_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^scene-[0-9]{3}$" },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 1 },
    "subtitle_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 80 },
    "visual": { "type": "string", "minLength": 1, "maxLength": 160 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at_ms", "action"],
        "properties": {
          "at_ms": { "type": "integer", "minimum": 0 },
          "action": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
    },
    "recipe_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^skill://[^\\s]+$" }
    }
  }
}
